require "json"
require "shellwords"
require "fileutils"
require "rbconfig"
require "yaml"
require "time"
require "digest"
require "fastlane_core/ipa_file_analyser"
require_relative "../scripts/screenshot-capture"
require_relative "../scripts/release-candidate"
require_relative "../scripts/testflight-build"

# Child tools must use the same Ruby as Bundler, not the macOS system Ruby.
ENV["PATH"] = "#{File.dirname(RbConfig.ruby)}:#{ENV.fetch('PATH')}"
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "60"

default_platform(:ios)

REQUIRED_RELEASE_DEVICES = ["iPhone 16e", "iPhone 17", "iPhone Duo"].freeze
TESTFLIGHT_DEVICE = "iPhone 17".freeze
TESTFLIGHT_GROUP = "Internal".freeze
TESTFLIGHT_PROCESSING_TIMEOUT = 30 * 60
TESTFLIGHT_POLL_INTERVAL = 30

def project_yml_path
  File.expand_path("../project.yml", __dir__)
end

def project_version
  YAML.load_file(project_yml_path).fetch("settings").fetch("base")
end

def source_revision
  sh("git rev-parse HEAD", log: false).strip
end

def working_tree_clean?
  sh("git status --porcelain", log: false).strip.empty?
end

def acceptance_devices
  ENV.fetch("IOS_TEST_DEVICES", REQUIRED_RELEASE_DEVICES.join(",")).split(",").map(&:strip).reject(&:empty?).uniq
end

def selected_simulators(names = acceptance_devices)
  begin
    overrides = JSON.parse(ENV.fetch("IOS_SIMULATOR_UDIDS", "{}"))
  rescue JSON::ParserError
    UI.user_error!("IOS_SIMULATOR_UDIDS must be a JSON object mapping device names to UDIDs.")
  end
  unless overrides.is_a?(Hash) && overrides.values.all? { |value| value.is_a?(String) && !value.empty? }
    UI.user_error!("IOS_SIMULATOR_UDIDS must be a JSON object mapping device names to UDIDs.")
  end
  inventory = JSON.parse(sh("ruby ../scripts/with-timeout.rb 60 xcrun simctl list devices available --json", log: false))
  runtimes = inventory.fetch("devices").select { |runtime, _| runtime.include?(".iOS-") }
  candidates = runtimes.sort_by { |runtime, _| Gem::Version.new(runtime.split(".iOS-").last.tr("-", ".")) }.reverse
  names.map do |name|
    match = candidates.flat_map { |runtime, devices| devices.map { |device| device.merge("runtime" => runtime) } }
                      .find { |device| device.fetch("name") == name && (!overrides.key?(name) || device.fetch("udid") == overrides.fetch(name)) }
    UI.user_error!("Missing simulator: #{name}. Install its runtime and create the device in Xcode.") unless match
    match
  end
end

def require_duo_environment!
  version = sh("xcodebuild -version", log: false).match(/Xcode (\d+\.\d+)/)
  UI.user_error!("Release requires Xcode 27.1 or later.") unless version && Gem::Version.new(version[1]) >= Gem::Version.new("27.1")
  missing = REQUIRED_RELEASE_DEVICES - acceptance_devices
  UI.user_error!("Release acceptance is missing: #{missing.join(', ')}.") unless missing.empty?
end

def require_api_key_environment!(purpose)
  %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |name|
    UI.user_error!("Set #{name} before #{purpose}.") if ENV[name].to_s.empty?
  end
  UI.user_error!("ASC_KEY_PATH must point to a local .p8 file.") unless File.file?(ENV.fetch("ASC_KEY_PATH"))
end

def require_release_environment!
  require_duo_environment!
  require_api_key_environment!("release")
end

def require_testflight_environment!
  UI.user_error!("Commit or stash all changes before a TestFlight build.") unless working_tree_clean?
  require_api_key_environment!("a TestFlight build")
end

def activate_simulator(device, devices = selected_simulators)
  devices.each do |other|
    next if other.fetch("udid") == device.fetch("udid") || other.fetch("state") != "Booted"
    next if ENV.fetch("IOS_KEEP_BOOTED_UDIDS", "").split(",").map(&:strip).include?(other.fetch("udid"))
    sh("ruby ../scripts/with-timeout.rb 60 xcrun simctl shutdown #{Shellwords.escape(other.fetch('udid'))}")
  end
  current = selected_simulators([device.fetch("name")]).find { |item| item.fetch("udid") == device.fetch("udid") }
  udid = Shellwords.escape(device.fetch("udid"))
  sh("ruby ../scripts/with-timeout.rb 60 xcrun simctl boot #{udid}") if current.fetch("state") == "Shutdown"
  output = sh("ruby ../scripts/with-timeout.rb 600 xcrun simctl bootstatus #{udid} -b")
  # simctl can report a terminal migration failure with exit status zero.
  UI.user_error!("Simulator data migration failed: #{device.fetch('name')} (#{device.fetch('udid')}).") if output.include?("Data Migration Failed")
end

def generate_project
  FileUtils.mkdir_p(File.expand_path("../build", __dir__))
  sh("cd .. && xcodegen generate --use-cache --cache-path build/xcodegen-cache")
end

def resolve_packages
  derived = File.expand_path(ENV.fetch("IOS_DERIVED_DATA", "build/DerivedData"), File.expand_path("..", __dir__))
  sh("xcodebuild -resolvePackageDependencies -project ../YouSkill.xcodeproj -scheme YouSkill -derivedDataPath #{Shellwords.escape(derived)} -onlyUsePackageVersionsFromResolvedFile")
end

def run_simulator_tests(device, output_directory)
  run_tests(
    project: "YouSkill.xcodeproj",
    scheme: "YouSkill",
    xcodebuild_command: "ruby #{Shellwords.escape(File.expand_path('../scripts/with-timeout.rb', __dir__))} 1200 xcodebuild",
    destination: "platform=iOS Simulator,id=#{device.fetch('udid')}",
    skip_detect_devices: true,
    force_quit_simulator: false,
    reset_simulator: false,
    disable_slide_to_type: false,
    only_testing: ["YouSkillTests", "YouSkillUITests"],
    # XCTest did not rotate Duo's cover display. verify-duo checks both displays through sim-use.
    skip_testing: device.fetch("name") == "iPhone Duo" ? ["YouSkillUITests/ReleaseAcceptanceTests/testRotationPreservesTheOpenReaderAndBackStack"] : [],
    parallel_testing: false,
    concurrent_workers: 1,
    disable_concurrent_testing: true,
    skip_package_dependencies_resolution: true,
    disable_package_automatic_updates: true,
    result_bundle: true,
    output_directory: "#{output_directory}/#{device.fetch('udid')}",
    derived_data_path: ENV.fetch("IOS_DERIVED_DATA", "build/DerivedData"),
    xcargs: "-collect-test-diagnostics never -test-timeouts-enabled YES -default-test-execution-time-allowance 600 -maximum-test-execution-time-allowance 600",
    fail_build: true
  )
end

def testflight_gate
  generate_project
  device = selected_simulators([TESTFLIGHT_DEVICE]).first
  resolve_packages
  activate_simulator(device, [device])
  run_simulator_tests(device, "build/test-results/#{Time.now.utc.strftime('%Y%m%dT%H%M%SZ')}-testflight")
end

def testflight_record_path(build_number)
  File.expand_path("../build/testflight/#{build_number}/build.json", __dir__)
end

def testflight_rerun_hint(build_number)
  "Run `bundle exec fastlane ios beta_distribute build:#{build_number}` to distribute this build without a second upload."
end

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

def testflight_app_identifier
  CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
end

def testflight_app
  Spaceship::ConnectAPI::App.find(testflight_app_identifier) || UI.user_error!("App Store Connect has no app #{testflight_app_identifier}.")
end

# What to Test texts of recent builds, newest first. Fetched lazily so the
# search stops at the first build that has a source revision. No includes:
# the default includes betaBuildMetrics, which App Store Connect rejects.
def previous_testflight_notes(app)
  Spaceship::ConnectAPI.get_builds(filter: { app: app.id }, includes: nil, sort: "-uploadedDate", limit: 20).to_models.lazy.map do |build|
    build.get_beta_build_localizations.map(&:whats_new)
  end
end

def testflight_build(app, version, build_number)
  Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build_number, limit: 1).first
end

def set_testflight_notes(build, notes)
  require "pilot"
  text = Pilot::BuildManager.sanitize_changelog(notes)
  localizations = build.get_beta_build_localizations
  if localizations.empty?
    Spaceship::ConnectAPI.post_beta_build_localizations(build_id: build.id, attributes: { locale: "en-US", whatsNew: text })
  else
    localizations.each do |localization|
      Spaceship::ConnectAPI.patch_beta_build_localizations(localization_id: localization.id, attributes: { whatsNew: text })
    end
  end
end

def internal_testflight_group(app)
  groups = app.get_beta_groups(filter: { name: TESTFLIGHT_GROUP }).select { |group| group.name == TESTFLIGHT_GROUP }
  group = groups.find(&:is_internal_group)
  return group if group
  UI.user_error!("The TestFlight group #{TESTFLIGHT_GROUP} is an external group. Rename it or make an internal group with that name.") unless groups.empty?
  UI.important("Creating the internal TestFlight group #{TESTFLIGHT_GROUP}. Add testers to it in App Store Connect.")
  app.create_beta_group(group_name: TESTFLIGHT_GROUP, is_internal_group: true, has_access_to_all_builds: false)
end

def testflight_group_ids(app, build)
  app.get_beta_groups(filter: { builds: build.id }).map(&:id)
end

def processed_testflight_build(app, version, build_number)
  build = testflight_build(app, version, build_number)
  return nil unless build
  state = build.processing_state
  if [Spaceship::ConnectAPI::Build::ProcessingState::FAILED, Spaceship::ConnectAPI::Build::ProcessingState::INVALID].include?(state)
    UI.user_error!("App Store Connect marked #{version} (#{build_number}) as #{state}.")
  end
  return nil unless state == Spaceship::ConnectAPI::Build::ProcessingState::VALID && build.build_beta_detail
  internal = Spaceship::ConnectAPI::BuildBetaDetail::InternalState
  case build.build_beta_detail.internal_build_state
  when internal::READY_FOR_BETA_TESTING, internal::IN_BETA_TESTING
    build
  when internal::PROCESSING
    nil
  else
    UI.user_error!("#{version} (#{build_number}) is #{build.build_beta_detail.internal_build_state} for internal testing. Fix it in App Store Connect, then: #{testflight_rerun_hint(build_number)}")
  end
end

def distribute_testflight_build(record, timeout: TESTFLIGHT_PROCESSING_TIMEOUT, interval: TESTFLIGHT_POLL_INTERVAL)
  version = record.fetch("version")
  build_number = record.fetch("build")
  hint = testflight_rerun_hint(build_number)
  app = testflight_app
  UI.message("Waiting up to #{timeout / 60} minutes for App Store Connect to process #{version} (#{build_number}).")
  build = begin
    TestFlightBuild.wait_until(timeout: timeout, interval: interval) { processed_testflight_build(app, version, build_number) }
  rescue TestFlightBuild::Timeout
    UI.user_error!("App Store Connect did not finish processing #{version} (#{build_number}) in #{timeout / 60} minutes. The upload is kept. #{hint}")
  end
  UI.success("State: processed. #{version} (#{build_number}) is ready for internal testing.")
  set_testflight_notes(build, record.fetch("notes"))
  group = internal_testflight_group(app)
  # A group with access to all builds receives every build; App Store Connect rejects an explicit add.
  unless group.has_access_to_all_builds
    build.add_beta_groups(beta_groups: [group])
    unless testflight_group_ids(app, build).include?(group.id)
      UI.user_error!("App Store Connect does not list #{version} (#{build_number}) in #{TESTFLIGHT_GROUP}. #{hint}")
    end
  end
  UI.success("State: available to testers. #{version} (#{build_number}) is in the internal group #{TESTFLIGHT_GROUP}.")
rescue FastlaneCore::Interface::FastlaneError => error
  raise if hint.nil? || error.message.include?(hint)
  UI.user_error!("#{error.message} #{hint}")
rescue StandardError => error
  UI.user_error!("TestFlight distribution of #{version} (#{build_number}) failed: #{error.message} #{hint}")
end

# Latest build number of the marketing version in App Store Connect. It
# includes TestFlight builds, whose numbers are not committed to project.yml.
def latest_connect_build_number(version)
  latest_testflight_build_number(api_key: connect_api_key, app_identifier: testflight_app_identifier, version: version, initial_build_number: 0)
end

def release_bump_hint
  "Run ./scripts/bump-build.sh, commit project.yml and YouSkill.xcodeproj, then run ios prepare_release again."
end

def require_release_build_number!
  version = project_version.fetch("MARKETING_VERSION").to_s
  committed = project_version.fetch("CURRENT_PROJECT_VERSION").to_s
  remote = latest_connect_build_number(version)
  begin
    greater = TestFlightBuild.greater_build_number?(committed, latest: [remote])
  rescue TestFlightBuild::Error => error
    UI.user_error!(error.message)
  end
  return if greater
  UI.user_error!("Build #{committed} is not greater than the latest App Store Connect build #{remote} of version #{version}. #{release_bump_hint}")
end

# Writes the next release build number to project.yml with the TestFlight rule,
# so the release build is greater than every uploaded build of the version.
def bump_release_build(dry_run: false)
  require_api_key_environment!("a release build number bump")
  version = project_version.fetch("MARKETING_VERSION").to_s
  committed = project_version.fetch("CURRENT_PROJECT_VERSION").to_s
  remote = latest_connect_build_number(version)
  begin
    build_number = TestFlightBuild.next_build_number(date: Time.now.strftime("%Y%m%d"), latest: [committed, remote])
  rescue TestFlightBuild::Error => error
    UI.user_error!(error.message)
  end
  UI.message("Release build #{version}: #{committed} -> #{build_number}, latest App Store Connect build #{remote}.")
  if dry_run
    UI.success("Dry run: project.yml is unchanged.")
    return build_number
  end

  pattern = /^([ \t]*CURRENT_PROJECT_VERSION:[ \t]*)\S+[ \t]*$/
  text = File.read(project_yml_path)
  UI.user_error!("project.yml must contain exactly one CURRENT_PROJECT_VERSION line.") unless text.scan(pattern).length == 1
  File.write(project_yml_path, text.sub(pattern) { "#{Regexp.last_match(1)}#{build_number}" })
  generate_project
  UI.success("Build number is now #{build_number}. Commit project.yml and YouSkill.xcodeproj before ios prepare_release.")
  build_number
end

def run_testflight_build(dry_run: false)
  require_testflight_environment!
  root = File.expand_path("..", __dir__)
  revision = source_revision
  version = project_version.fetch("MARKETING_VERSION").to_s
  testflight_gate
  UI.user_error!("The gate changed the working tree. Commit or discard the changes, then run ios beta again.") unless working_tree_clean?
  api_key = connect_api_key
  remote = latest_testflight_build_number(api_key: api_key, app_identifier: testflight_app_identifier, version: version, initial_build_number: 0)
  begin
    build_number = TestFlightBuild.next_build_number(
      date: Time.now.strftime("%Y%m%d"),
      latest: [project_version.fetch("CURRENT_PROJECT_VERSION"), remote]
    )
    previous = TestFlightBuild.previous_revision(previous_testflight_notes(testflight_app))
    notes = TestFlightBuild.notes(root: root, revision: revision, previous_revision: previous)
  rescue TestFlightBuild::Error => error
    UI.user_error!(error.message)
  end
  UI.message("TestFlight build #{version} (#{build_number}), latest App Store Connect build #{remote}.\nWhat to Test:\n#{notes}")
  if dry_run
    UI.success("Dry run: stopped before the archive. Nothing was uploaded.")
    return nil
  end

  output_directory = "build/testflight/#{build_number}"
  build_app(
    project: "YouSkill.xcodeproj",
    scheme: "YouSkill",
    configuration: "Release",
    skip_package_dependencies_resolution: true,
    disable_package_automatic_updates: true,
    derived_data_path: ENV.fetch("IOS_DERIVED_DATA", "build/DerivedData"),
    export_method: "app-store",
    output_directory: output_directory,
    output_name: "YouSkill.ipa",
    # The build number exists only in this archive; project.yml keeps its committed value.
    xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{build_number}",
    export_options: {
      signingStyle: "automatic",
      teamID: "HC438T2B8P",
      manageAppVersionAndBuildNumber: false,
      uploadSymbols: true
    }
  )
  ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
  unless FastlaneCore::IpaFileAnalyser.fetch_app_version(ipa) == version && FastlaneCore::IpaFileAnalyser.fetch_app_build(ipa) == build_number
    UI.user_error!("The IPA is not #{version} (#{build_number}).")
  end
  UI.user_error!("Source changed during the TestFlight build. Run ios beta again.") unless source_revision == revision && working_tree_clean?
  record = { "version" => version, "build" => build_number, "revision" => revision, "notes" => notes, "ipa" => ipa }
  FileUtils.mkdir_p(File.dirname(testflight_record_path(build_number)))
  File.write(testflight_record_path(build_number), JSON.pretty_generate(record))
  upload_to_testflight(api_key: api_key, ipa: ipa, skip_waiting_for_build_processing: true, skip_submission: true, distribute_external: false)
  UI.success("State: uploaded. #{version} (#{build_number}) is in App Store Connect. It is not yet processed or available to testers.")
  distribute_testflight_build(record)
  record
end

platform :ios do
  desc "Check the simulator inventory and generate the Xcode project"
  lane :prepare do
    UI.user_error!("IOS_TEST_DEVICES must contain at least one device name.") if acceptance_devices.empty?
    generate_project
    selected_simulators
    resolve_packages
  end

  desc "Run logic and user-flow tests on every required simulator"
  lane :verify do
    prepare
    output_directory = "build/test-results/#{Time.now.utc.strftime('%Y%m%dT%H%M%SZ')}"
    selected_simulators.each do |device|
      activate_simulator(device)
      if device.fetch("name") == "iPhone Duo"
        sh("ruby ../scripts/with-timeout.rb 60 sim-use ios fold closed --device #{Shellwords.escape(device.fetch('udid'))} --json")
      end
      run_simulator_tests(device, output_directory)
      if device.fetch("name") == "iPhone Duo"
        sh("ruby ../scripts/with-timeout.rb 600 ruby ../scripts/verify-duo.rb #{Shellwords.escape(device.fetch('udid'))} #{Shellwords.escape(File.expand_path("../#{output_directory}", __dir__))}")
      end
    end
    File.write(File.expand_path("../#{output_directory}/acceptance.json", __dir__), JSON.pretty_generate({
      revision: source_revision,
      working_tree_dirty: !sh("git status --porcelain", log: false).strip.empty?,
      version: project_version.fetch("MARKETING_VERSION").to_s,
      build: project_version.fetch("CURRENT_PROJECT_VERSION").to_s,
      devices: selected_simulators,
      completed_at: Time.now.utc.iso8601
    }))
  end

  desc "Run acceptance before capturing localized App Store screenshots"
  lane :screenshots do
    require_duo_environment!
    verify
    capture_store_screenshots
  end

  private_lane :capture_store_screenshots do
    root = File.expand_path("screenshots", __dir__)
    UI.user_error!("Move the existing fastlane/screenshots directory before capturing a new set.") if Dir.exist?(root)
    configuration_path = File.expand_path("~/Library/Caches/com.gumpw.youskill.screenshots/config.json")
    FileUtils.mkdir_p(File.dirname(configuration_path))
    duo = selected_simulators.find { |device| device.fetch("name") == "iPhone Duo" }
    duo_started = false
    status_bar_device = nil
    groups = acceptance_devices.reject { |name| name == "iPhone Duo" }.map { |name| ["phones", name] }
    groups += [["closed", "iPhone Duo"], ["open", "iPhone Duo"]] if duo
    groups.each do |posture, name|
      device = selected_simulators.find { |item| item.fetch("name") == name }
      activate_simulator(device)
      udid = Shellwords.escape(device.fetch("udid"))
      if posture != "phones"
        duo_started = true
        sh("ruby ../scripts/with-timeout.rb 60 sim-use ios fold #{posture} --device #{udid} --json")
      end
      status_bar_device = udid
      sh("ruby ../scripts/with-timeout.rb 60 xcrun simctl status_bar #{udid} override --time '9:41' --batteryState charged --batteryLevel 100")
      output = "build/screenshots/#{Time.now.utc.strftime('%Y%m%dT%H%M%SZ')}-#{device.fetch('udid')}-#{posture}"
      { "en-US" => "en_US", "zh-Hans" => "zh_CN", "ja" => "ja_JP", "ko" => "ko_KR" }.each do |language, locale|
        directory = File.expand_path("../#{output}/#{language}", __dir__)
        FileUtils.mkdir_p(directory)
        File.write(configuration_path, JSON.generate({ language: language, locale: locale, outputDirectory: directory, posture: posture }))
        capture = SimulatorScreenshotCapture.new(device: device.fetch("udid"), directory: directory)
        capture.start
        begin
          run_tests(
            project: "YouSkill.xcodeproj",
            scheme: "YouSkillScreenshots",
            xcodebuild_command: "ruby #{Shellwords.escape(File.expand_path('../scripts/with-timeout.rb', __dir__))} 1200 xcodebuild",
            destination: "platform=iOS Simulator,id=#{device.fetch('udid')}",
            skip_detect_devices: true,
            force_quit_simulator: false,
            reset_simulator: false,
            disable_slide_to_type: false,
            parallel_testing: false,
            disable_concurrent_testing: true,
            skip_package_dependencies_resolution: true,
            disable_package_automatic_updates: true,
            derived_data_path: ENV.fetch("IOS_DERIVED_DATA", "build/DerivedData"),
            output_directory: "#{output}/#{language}/results",
            result_bundle: true,
            xcargs: "-collect-test-diagnostics never -test-timeouts-enabled YES -default-test-execution-time-allowance 600 -maximum-test-execution-time-allowance 600",
            fail_build: true
          )
        ensure
          capture.stop
        end
        files = Dir.glob(File.join(directory, "*.png"))
        UI.user_error!("Incomplete screenshots for #{name}/#{posture}/#{language}.") unless files.length == 5
        destination = File.join(root, language)
        FileUtils.mkdir_p(destination)
        files.each do |file|
          if posture != "phones"
            dimensions = File.binread(file, 24).byteslice(16, 8).unpack("NN").sort
            expected = posture == "closed" ? [1398, 2034] : [2007, 2853]
            UI.user_error!("Unexpected Duo #{posture} screenshot dimensions: #{dimensions.inspect}") unless dimensions == expected
          end
          FileUtils.cp(file, File.join(destination, "#{posture}-#{name}-#{File.basename(file)}"))
        end
      end
      sh("ruby ../scripts/with-timeout.rb 60 xcrun simctl status_bar #{udid} clear")
      status_bar_device = nil
    end
  ensure
    cleanup = []
    cleanup << "xcrun simctl status_bar #{status_bar_device} clear" if status_bar_device
    cleanup << "sim-use ios fold closed --device #{Shellwords.escape(duo.fetch('udid'))} --json" if duo && duo_started
    cleanup.each do |command|
      begin
        sh("ruby ../scripts/with-timeout.rb 60 #{command}")
      rescue StandardError => error
        UI.error("Simulator cleanup failed: #{error.message}")
      end
    end
    FileUtils.rm_f(configuration_path) if configuration_path
  end

  desc "Verify, capture screenshots, and archive the committed release"
  lane :prepare_release do |options|
    require_duo_environment!
    UI.user_error!("Commit the release source and build number before release.") unless sh("git status --porcelain", log: false).strip.empty?
    build_number = project_version.fetch("CURRENT_PROJECT_VERSION").to_s
    if options[:build] && options[:build].to_s != build_number
      UI.user_error!("Set CURRENT_PROJECT_VERSION in project.yml and commit it before release.")
    end
    require_api_key_environment!("release")
    require_release_build_number!
    version = project_version.fetch("MARKETING_VERSION").to_s
    revision = source_revision
    verify
    capture_store_screenshots
    build_app(
      project: "YouSkill.xcodeproj",
      scheme: "YouSkill",
      configuration: "Release",
      skip_package_dependencies_resolution: true,
      disable_package_automatic_updates: true,
      derived_data_path: ENV.fetch("IOS_DERIVED_DATA", "build/DerivedData"),
      export_method: "app-store",
      output_directory: "build/release",
      output_name: "YouSkill.ipa",
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
        teamID: "HC438T2B8P",
        manageAppVersionAndBuildNumber: false,
        uploadSymbols: true
      }
    )
    UI.user_error!("Source changed during release. Run the release again.") unless source_revision == revision && sh("git status --porcelain", log: false).strip.empty?
    assets = Dir.glob(File.expand_path("screenshots/*/*.png", __dir__))
    assets << lane_context[SharedValues::IPA_OUTPUT_PATH]
    manifest = { revision: revision, version: version, build: build_number,
                 files: assets.to_h { |path| [File.expand_path(path), Digest::SHA256.file(path).hexdigest] } }
    File.write(File.expand_path("../build/release/manifest.json", __dir__), JSON.pretty_generate(manifest))
    UI.success("Release prepared. Inspect the screenshots before running ios release.")
  end

  desc "Upload the inspected, verified release and request App Store review"
  lane :release do |options|
    require_release_environment!
    path = File.expand_path("../build/release/manifest.json", __dir__)
    UI.user_error!("Run ios prepare_release and inspect its screenshots first.") unless File.file?(path)
    manifest = JSON.parse(File.read(path))
    root = File.expand_path("..", __dir__)
    acceptance = Dir.glob(File.join(root, "build/test-results/*/acceptance.json")).filter_map do |file|
      record = JSON.parse(File.read(file))
      record if record["revision"] == manifest.fetch("revision")
    end.last
    begin
      evidence = ReleaseCandidate.validate!(
        root: root, manifest: manifest,
        version: project_version.fetch("MARKETING_VERSION").to_s,
        build: project_version.fetch("CURRENT_PROJECT_VERSION").to_s,
        reuse: options[:reuse_prepared].to_s == "true", acceptance: acceptance,
        required_devices: REQUIRED_RELEASE_DEVICES
      )
    rescue ArgumentError => error
      UI.user_error!(error.message)
    end
    File.write(File.join(root, "build/release/submission-source.json"), JSON.pretty_generate(evidence))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    ipa = manifest.fetch("files").keys.find { |file| file.end_with?(".ipa") }
    unless FastlaneCore::IpaFileAnalyser.fetch_app_version(ipa) == manifest.fetch("version") &&
           FastlaneCore::IpaFileAnalyser.fetch_app_build(ipa) == manifest.fetch("build")
      UI.user_error!("IPA version or build does not match the manifest.")
    end
    upload_to_app_store(
      api_key: api_key,
      app_version: manifest.fetch("version"),
      ipa: ipa,
      metadata_path: "fastlane/metadata",
      screenshots_path: ReleaseCandidate.select_screenshots!(root: root, manifest: manifest),
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Set the next release build number in project.yml from App Store Connect and regenerate the project"
  lane :bump_build do |options|
    bump_release_build(dry_run: options[:dry_run].to_s == "true")
  end

  desc "Test on iPhone 17, then upload the current commit to TestFlight for internal testers"
  lane :beta do |options|
    run_testflight_build(dry_run: options[:dry_run].to_s == "true")
  end

  desc "Wait for processing and distribute an uploaded TestFlight build without a second upload"
  lane :beta_distribute do |options|
    require_api_key_environment!("TestFlight distribution")
    build_number = options[:build].to_s
    UI.user_error!("Pass the uploaded build number, for example build:202611021.") if build_number.empty?
    path = testflight_record_path(build_number)
    UI.user_error!("No TestFlight build record at #{path}. Run this lane on the Mac that uploaded the build.") unless File.file?(path)
    connect_api_key
    distribute_testflight_build(JSON.parse(File.read(path)))
  end
end
